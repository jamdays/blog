---
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import { Image } from 'astro:assets';
import type {CollectionEntry} from 'astro:content';


type Props = CollectionEntry<'sotw'>['data'];

const {title, artist, link, releaseDate, pubDate, updatedDate, coverArt} = Astro.props;
---
<html lang="en">
	<head>
		<BaseHead title={title} description={`SotW`}/>
	</head>
	<body>
		<Header/>
		<main>
		<article>
			<div class="card">
			<div class="sotw-title">
			<div class="title">
				<div class="container">
				{ coverArt && ( 
				<Image
				src={coverArt}
				alt={`Cover art for ${title}`}
				width={300}
				height={300}
				/>)}
				<div class="info">
				<a href={link}><h2>{title}</h2></a>
				<h3>{artist} &#x2022; {releaseDate}</h3>
				</div>
				</div>
				<div class="date" >
					<time datetime={pubDate.toISOString()}>
					  {
					    pubDate.toLocaleDateString('en-US', {
					      year: 'numeric',
					      month: 'long',
					      day: 'numeric',
					    })
					  }
					</time>
					{
					updatedDate && (
					<div class="last-updated-on">
						Last updated on {updatedDate} 
					</div> )
						}
				</div>
				<hr/>
			</div>
			</div>
			<slot/>
			</div>
		</article>
		</main>
	</body>
</html>
<style>
  .container {
	  display: flex;
	  align-items: center;
  }
  .info {
	  flex: 1;
	  text-align: center;
  }
</style>
