---
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import type {CollectionEntry} from 'astro:content';


type Props = CollectionEntry<'qotw'>['data'];

const {quote, author, releaseDate, pubDate, updatedDate} = Astro.props;
---
<html lang="en">
	<head>
		<BaseHead title={`QotW`} description={`QotW`}/>
	</head>
	<body>
		<Header/>
		<main>
		<article>
			<div class="card">
			<div class="qotw-title">
			<div class="title">
				<h2>"{quote}"</h2>
				<h3>-{author} &#x2022; {releaseDate}</h3>
				<div class="date" >
					<time datetime={pubDate.toISOString()}>
					  {
					    pubDate.toLocaleDateString('en-US', {
					      year: 'numeric',
					      month: 'long',
					      day: 'numeric',
					    })
					  }
					</time>
					{
					updatedDate && (
					<div class="last-updated-on">
						Last updated on {updatedDate} 
					</div> )
						}
				</div>
				<hr/>
			</div>
			</div>
			<slot/>
			</div>
		</article>
		</main>
	</body>
</html>
