const pos = [12, 3, 0];


function refresh(){
  for (let r = -1; r < 2; r++){
  for (let c = -1; c < 2; c++){
	if (pos[0] + r >= height || pos[0] + r < 0 || pos[1] + c < 0 || pos[1] + c >= width){
		if (pos[2] == 0)
			document.querySelector("#" + CSS.escape(`${(r + 1)*3 + c + 1}`)).innerHTML = images["t"];
		if (pos[2] == 1)
			document.querySelector("#" + CSS.escape(`${(r + 1)*3 + c + 1}`)).innerHTML = images["b"];
	}
	else {
		document.querySelector("#" + CSS.escape(`${(r + 1)*3 + c + 1}`)).innerHTML = images[map[pos[2]][pos[0] + r][pos[1] + c]];
			//document.querySelector(`#${(r + 1)*3 + c + 1}`).innerHTML = 
	}
  }
  }
}

function in_bounds(dr, dc){
		return pos[1] + dc > -1 && pos[1] + dc < width && pos[0] + dr > -1 && pos[0] + dr < height;
}

function move(dr, dc){
	if (in_bounds(dr, dc) && map[pos[2]][pos[0] + dr][pos[1] + dc] == "o"){
		map[pos[2]][pos[0]][pos[1]] = "o";
		pos[0] = pos[0] + dr;
		pos[1] = pos[1] + dc;
		map[pos[2]][pos[0]][pos[1]] = "x";
		document.querySelector("#dialouge").innerHTML = dialouge["o"];
	}
	else if (in_bounds(dr, dc)){
		if (!isNaN(map[pos[2]][pos[0] + dr][pos[1] + dc])){
			map[pos[2]][pos[0]][pos[1]] = "o";
			pos[2] = parseInt(map[pos[2]][pos[0] + dr][pos[1] + dc]);
			map[pos[2]][pos[0]][pos[1]] = "x";
		}
		document.querySelector("#dialouge").innerHTML = dialouge[map[pos[2]][pos[0] + dr][pos[1] + dc]];
	}
	else {
		if (pos[2] == 0)
			document.querySelector("#dialouge").innerHTML = dialouge["t"];
	}
	refresh();
}


function action(e) {
	console.log(`${e.code}`)
	if (`${e.code}` == "KeyH"){
		move(0, -1);	
	}
	if (`${e.code}` == "KeyL"){
		move(0, 1);	
	}
	if (`${e.code}` == "KeyK"){
		move(-1, 0);	
	}
	if (`${e.code}` == "KeyJ"){
		move(1, 0);	
	}
}

document.addEventListener("keypress", action);

