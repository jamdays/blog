---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
---
<a href={`/other/qotw/${href}`} class:list={[className]} {...props}>
	<div class="container">
	<div class="info">
	<slot name="quote"><h3>Title</h3></slot>
	<slot name="author"><p>Those who know</p></slot>
	</div>
	</div>
	<hr>
</a>
<style>
  a {
    text-decoration: none;
    color: var(--blue);
  }
  .container {
	  display: flex;
	  align-items: center;
  }
  .info {
	  flex: 1;
	  text-align: center;
  }
</style>
