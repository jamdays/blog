---
import type { HTMLAttributes } from 'astro/types';
import {Image} from 'astro:assets';

type Props = HTMLAttributes<'a'>;

const { href, imgsrc, class: className, ...props } = Astro.props;
---
<a href={`/other/sotw/${href}`} class:list={[className]} {...props}>
	<div class="container">
		<Image src={imgsrc} alt ="Cover Art" height={100} width={100}/>
	<div class="info">
	<slot name="title"><h3>Title</h3></slot>
	<slot name="artist"><p>Those who know</p></slot>
	</div>
	</div>
	<hr>
</a>
<style>
  a {
    text-decoration: none;
    color: var(--blue);
  }
  .container {
	  display: flex;
	  align-items: center;
  }
  .info {
	  flex: 1;
	  text-align: center;
  }
</style>
