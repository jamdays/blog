---
import { getCollection } from 'astro:content';
import Header  from "@components/Header.astro";
import SotWLink from "@components/SotWLink.astro";
import BaseHead from "@components/BaseHead.astro";
import {Font} from 'astro:assets';
import '@styles/global.css';

const sotw = await getCollection('sotw');
---

<html lang="en">
	<head>
	<BaseHead title="Other" description="Other Things"/>
	</head>
	<Header/>
	<body>
		<div class="card">
		{
		  sotw.map((post) => (
		  <SotWLink href={post.id} imgsrc={post.data.coverArt}>
		      <h3 slot="title">{post.data.title}</h3>
		      <p slot="artist">{post.data.artist}</p>
		    </SotWLink>
		  ))
		}
		</div>
	</body>
</html>
